# Copy to .env and fill in. Get both from Supabase → Project Settings → API Keys.
# Use the PUBLISHABLE key (sb_publishable_…) only — never the secret / service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
