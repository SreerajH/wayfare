{
  "expo": {
    "name": "Wayfare",
    "slug": "wayfare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wayfare",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1E1F21",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.sreerajh.wayfare"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E1F21",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sreerajh.wayfare"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1F21",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#1E1F21",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wayfare uses your photos so you can set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "sreerajh",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a8d5807e-4a4c-48d5-a6f0-d9b870581d16"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/a8d5807e-4a4c-48d5-a6f0-d9b870581d16",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
